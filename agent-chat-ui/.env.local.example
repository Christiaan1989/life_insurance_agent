# OpenAI API Configuration
OPENAI_API_KEY=sk-...your-key-here

# Optional: Whisper model configuration (defaults to whisper-1)
WHISPER_MODEL=whisper-1

# Optional: Realtime voice I/O configuration.
# Realtime is tried first for microphone transcription and assistant speech;
# Whisper and /api/tts remain as fallbacks.
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_REALTIME_TRANSCRIBE_LANGUAGE=en
NEXT_PUBLIC_ENABLE_REALTIME_VOICE=true

# LangGraph / Agent Chat Configuration
NEXT_PUBLIC_API_URL=http://localhost:2024
NEXT_PUBLIC_ASSISTANT_ID=atlas_v2

# Insurance API (for dashboard charts/metrics)
NEXT_PUBLIC_INSURANCE_API_URL=http://localhost:8000
NEXT_PUBLIC_INSURANCE_API_KEY=demo-api-key-2025
